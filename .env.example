# Anthropic API キー（辞書生成・文法ワンポイント用）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-api03-...

# NextAuth / Auth.js（ログイン・私訳保存）
# 生成: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth（https://console.cloud.google.com/）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon PostgreSQL（私訳・公開メモの保存）
DATABASE_URL=

# 使い方:
#   1. このファイルをコピー:  cp .env.example .env.local
#   2. .env.local に実際の値を書く
#   3. 辞書を再生成:  npm run generate:ot-lexicon
#      （本文とは独立。API不要で取込: node scripts/gen-ot-lexicon.mjs --bootstrap）
